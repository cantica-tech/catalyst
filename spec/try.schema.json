{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cantica-tech/catalyst/spec/try.schema.json",
  "title": "catalyst try",
  "description": "What `catalyst try <verb …> --json` prints (design 27): one change made on a scratch copy of the criterion, and what it would do. Nothing in the criterion changes.",
  "type": "object",
  "required": [
    "change",
    "ok",
    "refused",
    "output",
    "files",
    "check",
    "impact",
    "gates",
    "scratch"
  ],
  "additionalProperties": false,
  "properties": {
    "change": {
      "type": "string",
      "description": "The command tried, as a shell would read it."
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the verb succeeded on the copy."
    },
    "refused": {
      "type": [
        "string",
        "null"
      ],
      "description": "What the verb said when it refused: the answer to the try."
    },
    "output": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "description": "Every file the change wrote (the journal's own shards left out), with its blob before and after; null: absent.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "before",
          "after"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "before": {
            "type": [
              "string",
              "null"
            ]
          },
          "after": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "added",
        "cleared"
      ],
      "additionalProperties": false,
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "cleared": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "impact": {
      "description": "`catalyst impact --json` for the entity the change touched last: `spec/impact.schema.json`, kept here as `$defs` (a test holds the two equal); null when it touched none.",
      "anyOf": [
        {
          "$ref": "#/$defs/impact"
        },
        {
          "type": "null"
        }
      ]
    },
    "gates": {
      "type": "array",
      "description": "What the change would leave waiting for an approval (design 25).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "gate",
          "missing"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "gate": {
            "type": "string"
          },
          "missing": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "scratch": {
      "type": [
        "string",
        "null"
      ],
      "description": "The scratch copy, when kept (--keep)."
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "level",
        "text",
        "entity"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "text": {
          "type": "string"
        },
        "entity": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "impact": {
      "description": "What `catalyst impact <id> --json` prints and `GET /v1/impact/<id>` returns: what an entity rests on (upstream) and what rests on it (downstream), transitively. `upstream` is absent with `--down`, `downstream` with `--up`.",
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "status",
        "mentions",
        "mentioned_by"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The entity: an artifact ID, a rule ID or a domain code."
        },
        "type": {
          "type": "string",
          "description": "An entity type's prefix, `rule` or `domain`."
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reached"
          }
        },
        "downstream": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reached"
          }
        },
        "mentions": {
          "type": "array",
          "description": "Entities this one cites in its prose only. Not followed.",
          "items": {
            "type": "string"
          }
        },
        "mentioned_by": {
          "type": "array",
          "description": "Entities that cite this one in their prose only. Not followed.",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "reached": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "status",
        "depth",
        "via"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "description": "Links from the entity asked about."
        },
        "via": {
          "type": "object",
          "description": "The link that reached it: `id`, the entity one step nearer; `field`, the reference field (`domain` for a rule's domain); `on`, the entity that carries the field (the nearer one upstream, the reached one downstream).",
          "required": [
            "id",
            "field",
            "on"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "on": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
