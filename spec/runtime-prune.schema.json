{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cantica-tech/catalyst/spec/runtime-prune.schema.json",
  "title": "catalyst runtime prune",
  "description": "What `catalyst runtime prune --json` prints: the runtimes under the home it keeps and why, those it removes (or would remove without `--yes`), and the space they take.",
  "type": "object",
  "required": [
    "home",
    "applied",
    "kept",
    "removed",
    "bytes"
  ],
  "additionalProperties": false,
  "properties": {
    "home": {
      "type": "string",
      "description": "`$CATALYST_HOME`, by default `~/.catalyst`."
    },
    "applied": {
      "type": "boolean",
      "description": "True with `--yes`: the runtimes were removed."
    },
    "kept": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "description": "Why it stays: the criteria whose `.venv` carries it, `running`, `newest`."
          }
        }
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "path",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "description": "The runtime's version, or a half-built `.<version>.building` directory's name."
          },
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "The space the removed runtimes take."
    }
  }
}
