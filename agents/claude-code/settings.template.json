{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.catalyst/bin/catalyst\" hook start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.catalyst/bin/catalyst\" hook stop"
          }
        ]
      }
    ]
  }
}
