def test_status_and_protection_payload(world):
    st = cr.status(load(world["bob"]), fetch=True)
    assert st.mode == "submodule" and st.branch == "criterion" and st.ahead == 0
    assert cr.github_repo("git@github.com:o/criterion.git") == "o/criterion"
    assert cr.protection_payload()["required_status_checks"]["contexts"] == ["catalyst"]
    with pytest.raises(cr.CriterionError, match="GitHub remotes only"):
        cr.protect(load(world["bob"]), apply=False)


def test_journal_blobs_travel_with_the_repository(world):
    """A fresh clone must hold every blob the journal references: pins are
    shared on create/push and fetched on join/sync, merged by union."""
    add_item(world["ada"], "ada", "Ada thing")
    a = push(world, "ada", "Ada adds an item")
    merge_topic(world, a.branch)
    add_item(world["bob"], "bob", "Bob thing")       # Bob pins in parallel
    b = push(world, "bob", "Bob adds an item")
    merge_topic(world, b.branch)
    fresh = world["tmp"] / "carol"
    subprocess.run(["git", "clone", "-q", "-b", "criterion", str(world["remote"]), str(fresh)], check=True)
    cr.share_pins(fresh, publish=False)
    for line in (fresh / "development" / "journal.jsonl").read_text().splitlines():
        for f in json.loads(line)["files"]:
            if f["after"] and f["path"].startswith(".criterion/"):
                assert j.blob_exists(fresh, f["after"]), f["path"]
    remote_pins = subprocess.run(["git", "-C", str(world["remote"]), "rev-list", "--parents", "-n", "1",
                                  "refs/catalyst/journal"], capture_output=True, text=True).stdout.split()
    assert len(remote_pins) >= 2


def test_next_push_after_a_merged_pr_starts_a_new_topic(world):
    add_item(world["ada"], "ada", "First")
    first = push(world, "ada", "first")
    merge_topic(world, first.branch)
    subprocess.run(["git", "-C", str(world["remote"]), "branch", "-D", first.branch], check=True)
    add_item(world["ada"], "ada", "Second")
    second = push(world, "ada", "second")
    assert second.branch != first.branch and second.commits >= 1


def test_push_never_overwrites_someone_elses_commit_on_the_pr_branch(world):
    add_item(world["ada"], "ada", "Mine")
    a = push(world, "ada", "mine")
    reviewer = world["tmp"] / "reviewer"
    subprocess.run(["git", "clone", "-q", "-b", a.branch, str(world["remote"]), str(reviewer)], check=True)
    git(reviewer, "config", "user.name", "Rev")
    git(reviewer, "config", "user.email", "rev@example.com")
    git(reviewer, "commit", "-q", "--allow-empty", "-m", "suggestion")
    git(reviewer, "push", "-q", "origin", a.branch)
    suggestion = git(reviewer, "rev-parse", "HEAD")
    add_item(world["ada"], "ada", "More")
    with pytest.raises(cr.CriterionError, match="does not have"):
        push(world, "ada", "more")
    assert git(world["remote"], "rev-parse", a.branch) == suggestion


def test_create_rolls_back_when_the_submodule_step_fails(tmp_path, monkeypatch):
    remote = tmp_path / "r.git"
    subprocess.run(["git", "init", "-q", "--bare", str(remote)], check=True)
    project = make_project(tmp_path / "p")
    agent = tmp_path / "agent" / ".criterion"
    agent.parent.mkdir()
    shutil.move(str(project / ".criterion"), str(agent))
    (project / ".criterion").symlink_to(agent)
    git_init(agent)
    git_init(project)
    monkeypatch.chdir(project)
    real_run = cr.run

    def failing_submodule_add(repo, *args, **kw):
        if args[:2] == ("submodule", "add"):
            raise cr.CriterionError("git submodule add failed: network down")
        return real_run(repo, *args, **kw)

    monkeypatch.setattr(cr, "run", failing_submodule_add)
    before = (project / ".gitignore").read_text()
    with pytest.raises(cr.CriterionError, match="nothing changed in the project"):
        cr.create(load(project), str(remote))
    assert (project / ".criterion").is_symlink() and (project / ".gitignore").read_text() == before
    assert not cr.is_submodule(project)
    load(project)                                           # still a working deployment


def test_sync_refuses_to_reset_a_branch_holding_unpushed_commits(world):
    wc = world["bob"] / ".criterion"
    git(wc, "commit", "-q", "--allow-empty", "-m", "local work")
    git(wc, "checkout", "-q", "--detach", "origin/criterion")   # what submodule update does
    with pytest.raises(cr.CriterionError, match="not on the remote"):
        cr.sync(load(world["bob"]))
    assert "local work" in git(wc, "log", "-1", "--format=%s", "criterion")


def test_a_clean_three_way_merge_of_one_artifact_is_journaled(world):
    for who, old, new in (("ada", "# `ITEM", "# `ITEM"), ("bob", "Text.", "Text, edited by Bob.")):
        dep = load(world[who])
        f = dep.root / "items" / "ITEM-000001-first-item.md"
        text = f.read_text()
        f.write_text(text.replace("| Open |", "| Done |") if who == "ada" else text.replace(old, new))
        j.append(dep, j.AppendRequest(command="/edit", action="update", artifact="ITEM-000001",
                                      targets=[], intent=[f"{who} edits"], files=[str(f)], actor=who))
    a = push(world, "ada", "status")
    merge_topic(world, a.branch)
    b = push(world, "bob", "text", checker=lambda dep: "\n".join(
        str(i) for i in j.verify(dep) if i.level == "error"))
    assert b.commits >= 1


