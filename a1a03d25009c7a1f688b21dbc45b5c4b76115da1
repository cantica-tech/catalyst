    assert git(bob, "symbolic-ref", "--short", "HEAD") == "criterion"


def test_concurrent_work_merges_without_losing_anything(world):
    a_item = add_item(world["ada"], "ada", "Ada thing")
    b_item = add_item(world["bob"], "bob", "Bob thing")
    assert a_item == f"ITEM-000002-{USERID}" and b_item == f"ITEM-000002-{BOB_ID}"  # same number, different signer
    a = push(world, "ada", "Ada adds an item")
    merge_topic(world, a.branch)
    b = push(world, "bob", "Bob adds an item")     # rebases onto Ada's merged work
    assert b.commits >= 1
    merged = merge_topic(world, b.branch)
    wc = world["bob"] / ".criterion"
    git(wc, "fetch", "-q", "origin")
    assert cr.integrity(wc, "origin/criterion") == []
    shared = cr.facts_at(wc, "origin/criterion")
    assert {a_item, b_item} <= shared.ids and {a_item, b_item} <= shared.rows
    entries = [json.loads(line) for line in shared.journal]
    assert sorted(e["actor"] for e in entries if e["command"] == "/create-item") == ["ada", "bob"]
    merge = [e for e in entries if e["command"] == "catalyst criterion push"]
    assert len(merge) == 1 and merge[0]["files"][0]["path"] == ".criterion/items/items.md"
    # Bob's rebased index lists both, in ID order
    index = subprocess.run(["git", "-C", str(wc), "show", "origin/criterion:items/items.md"],
                           capture_output=True, text=True).stdout
    assert index.index("ITEM-000001") < index.index(a_item) and b_item in index
    assert merged
    # after syncing, the union-merged journal verifies: forks are warnings, not errors
    cr.sync(load(world["bob"]))
    issues = [i for i in j.verify(load(world["bob"])) if i.level == "error"]
    assert issues == []


def test_sync_refuses_local_work_then_fast_forwards(world):
    add_item(world["ada"], "ada", "Ada thing")
    a = push(world, "ada", "Ada adds an item")
    merge_topic(world, a.branch)
    bob = world["bob"]
    write(bob / ".criterion" / "scratch.md", "unsaved\n")
    with pytest.raises(cr.CriterionError, match="uncommitted"):
        cr.sync(load(bob))
    (bob / ".criterion" / "scratch.md").unlink()
    git(bob / ".criterion", "commit", "-q", "--allow-empty", "-m", "local only")
    with pytest.raises(cr.CriterionError, match="not on the remote"):
        cr.sync(load(bob))
    git(bob / ".criterion", "reset", "-q", "--hard", "HEAD~1")
    cr.sync(load(bob))
    assert f"ITEM-000002-{USERID}" in (bob / ".criterion" / "items" / "items.md").read_text()


def test_a_real_conflict_stops_the_push(world):
    for who in ("ada", "bob"):
        f = world[who] / ".criterion" / "items" / "ITEM-000001-first-item.md"
        f.write_text(f.read_text().replace("| Open |", f"| Done by {who} |"))
    a = push(world, "ada", "Ada closes it")
    merge_topic(world, a.branch)
    wc = world["bob"] / ".criterion"
    with pytest.raises(cr.CriterionConflict) as exc:
        push(world, "bob", "Bob closes it too")
    assert "items/ITEM-000001-first-item.md" in exc.value.files
    assert "RECON" in str(exc.value)
    # nothing half-done: no rebase in progress, Bob's commit intact, nothing pushed
    assert not (Path(git(wc, "rev-parse", "--git-dir")) / "rebase-merge").exists()
    assert "Done by bob" in git(wc, "show", "HEAD:items/ITEM-000001-first-item.md")
    assert git(wc, "ls-remote", "--heads", "origin", "bob/*") == ""


def test_failing_check_blocks_the_push(world):
    add_item(world["ada"], "ada", "Ada thing")
    with pytest.raises(cr.CriterionError, match="nothing was pushed"):
        push(world, "ada", "broken", checker=lambda dep: "ERROR chain dangling-ref")
    assert git(world["ada"] / ".criterion", "ls-remote", "--heads", "origin", "ada/*") == ""


def test_integrity_catches_a_merge_that_drops_a_journal_line(world):
    add_item(world["ada"], "ada", "Ada thing")
    a = push(world, "ada", "Ada adds an item")
    wc = world["ada"] / ".criterion"
    git(wc, "checkout", "-q", "criterion")
    git(wc, "merge", "-q", "--no-ff", "--no-commit", a.branch)
    (wc / "development" / "journal.jsonl").write_text("")       # a bad merge resolution
    git(wc, "add", "-A")
    git(wc, "commit", "-q", "-m", "bad merge")
    problems = cr.integrity(wc)
    assert any("journal line" in p for p in problems)


